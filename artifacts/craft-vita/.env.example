# HireShade desktop launcher — environment template.
# Copy to .env and fill in. .env is gitignored; this file is committed.
# Only VITE_* vars are read (Vite inlines them at build time). None of these
# are secrets by themselves, but keep real values out of the repo.

VITE_BACKEND_URL=http://localhost:5051
VITE_APP_WEB_URL=http://localhost:5173
VITE_FRONTEND_URL=http://localhost:5173
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
