{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HireShade",
  "version": "0.1.9",
  "identifier": "org.hireshade.app",
  "build": {
    "beforeDevCommand": "env PORT=5173 BASE_PATH=/ pnpm exec vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "env PORT=5173 BASE_PATH=./ pnpm build && node ../../scripts/verify-bundle.cjs",
    "frontendDist": "../dist/public"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "mini",
        "title": "HireShade Floating Screen",
        "url": "floating.html",
        "transparent": true,
        "decorations": false,
        "width": 700,
        "height": 360,
        "minWidth": 360,
        "minHeight": 200,
        "visible": false,
        "center": true,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "contentProtected": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "useHttpsScheme": true
      },
      {
        "label": "launcher",
        "title": "HireShade",
        "url": "launcher.html",
        "width": 480,
        "height": 680,
        "minWidth": 320,
        "minHeight": 180,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "center": true,
        "resizable": true,
        "contentProtected": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": true
    },
    "updater": {
      "endpoints": [
        "https://hireshade.com/api/desktop/latest"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1MEJGMjhCRkQwRDBGMTMKUldRVER3MzlpL0lMZFFGY1FKQTRsVlpZeDBMbmQwWEVlOEFMK0dWVUdoZlFKRVFnRzdwYTA1YXUK"
    }
  }
}
