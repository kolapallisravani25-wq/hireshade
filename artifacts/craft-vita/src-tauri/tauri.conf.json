{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HireShade",
  "version": "0.0.10",
  "identifier": "org.hireshade.app",
  "build": {
    "beforeDevCommand": "env PORT=5173 BASE_PATH=/ pnpm exec vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "env PORT=5173 BASE_PATH=/ pnpm build",
    "frontendDist": "../dist/public"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "mini",
        "title": "HireShade Floating Screen",
        "url": "floating.html",
        "transparent": true,
        "decorations": false,
        "width": 700,
        "height": 360,
        "minWidth": 360,
        "minHeight": 200,
        "visible": false,
        "center": true,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "contentProtected": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      },
      {
        "label": "launcher",
        "title": "HireShade",
        "url": "launcher.html",
        "width": 460,
        "height": 260,
        "minWidth": 320,
        "minHeight": 180,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "center": true,
        "resizable": true,
        "contentProtected": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "hireshade"
        ]
      }
    },
    "fs": {
      "requireLiteralLeadingDot": true
    },
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
