# HireShade API server — environment template.
# Copy to .env and fill in. .env is gitignored; this file is committed.
# Never commit real values: CLERK_SECRET_KEY, OPENROUTER_API_KEY,
# DEEPGRAM_API_KEY and DESKTOP_TOKEN_SECRET are all secrets.

PORT=5051
DATABASE_URL=postgresql://user:password@localhost:5433/hireshade_dev
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_ISSUER_DOMAIN=your-domain.clerk.accounts.dev
OPENROUTER_API_KEY=your_key_here
DEEPGRAM_API_KEY=your_key_here
DESKTOP_TOKEN_SECRET=generate_a_random_64_char_hex_string
FREE_SESSIONS_PER_DAY=30
NODE_ENV=development
