# HireShade — root environment template.
# Copy to .env (gitignored). NEVER commit real values.
# The demo path works with every provider key empty: set DEMO_MODE=1 and run `make demo`.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=5051

# ── Database (Postgres 16; docker container on 5433 is what validation used) ──
DATABASE_URL=postgresql://hireshade_dev:replace_me@localhost:5433/hireshade_dev

# ── Demo / mock providers (refused when NODE_ENV=production) ─────────────────
DEMO_MODE=1
VITE_DEMO_MODE=1

# ── Auth (Clerk) ─────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_ISSUER_DOMAIN=your-domain.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://localhost:5051
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_BACKEND_URL=http://localhost:5051
VITE_APP_WEB_URL=http://localhost:5173
VITE_FRONTEND_URL=http://localhost:5173

# ── AI (multi-provider via OpenRouter) ───────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_STREAM_IDLE_MS=45000
OPENROUTER_MAX_TOKENS=2000
ANSWER_MODEL=anthropic/claude-haiku-4.5
ASK_AI_MAX_TOKENS=2000

# ── Speech-to-text (Deepgram; server mints short-lived tokens) ───────────────
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=
DEEPGRAM_TEMP_KEY_TTL_SECONDS=7200

# ── Desktop auth / release proxy ─────────────────────────────────────────────
DESKTOP_TOKEN_SECRET=replace_with_64_hex_chars
PUBLIC_BACKEND_URL=http://localhost:5051
DESKTOP_RELEASES_REPO=hireshade/hireshade-desktop-releases
GITHUB_RELEASES_TOKEN=
UPLOADS_SIGNING_SECRET=replace_with_random_hex

# ── Billing: Razorpay (existing) ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Billing: Stripe (new provider; webhook POST /api/stripe/webhook) ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Optional explicit price ids (otherwise the T-12 catalog amounts are used):
STRIPE_PRICE_CREDIT_1=
STRIPE_PRICE_CREDIT_3=
STRIPE_PRICE_CREDIT_6=
STRIPE_PRICE_CREDIT_9=
STRIPE_PRICE_SUBSCRIPTION_WEEKLY=
STRIPE_PRICE_SUBSCRIPTION_MONTHLY=
STRIPE_PRICE_SUBSCRIPTION_YEARLY=
STRIPE_PRICE_PREPAID_YEARLY=
STRIPE_PRICE_LIFETIME_PLAN=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel
STRIPE_API_VERSION=2026-09-30.endive
# STRIPE_MOCK=1   # test/dev only; ignored when NODE_ENV=production

# ── Limits / exports ─────────────────────────────────────────────────────────
FREE_SESSIONS_PER_DAY=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5051
PDF_CHROME_PATH=
PDF_RENDER_TIMEOUT_MS=30000
AI_ACTIONS_PER_MINUTE=30

# ── Optional test/demo knobs ─────────────────────────────────────────────────
# CLASSIFIER_EVIDENCE_DIR=docs/evidence/classifier
