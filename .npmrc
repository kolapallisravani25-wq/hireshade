auto-install-peers=false
strict-peer-dependencies=false
optional=true

# NOTE: Do NOT add a `supportedArchitectures` block here. Each desktop-build.yml
# matrix runner (ubuntu/windows/macos) builds on its own native OS and installs
# its own platform's optional native deps (@rollup/rollup-*, @esbuild/*)
# automatically. A cross-arch block that pins `libc[]=glibc` filters OUT the
# win32/darwin binaries (which have no glibc), which caused Windows/macOS builds
# to fail with "Cannot find module @rollup/rollup-win32-x64-msvc" and no MSI/EXE
# asset was ever produced.
